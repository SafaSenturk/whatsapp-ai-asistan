# Bu dosyayı .env.local adıyla kopyalayıp değerleri doldurun.
# .env.local git'e girmez; anahtarları kimseyle paylaşmayın.

# --- Zorunlu ---------------------------------------------------------------
# Rastgele uzun bir metin (oturum çerezlerini imzalar). Örn: openssl rand -hex 32
SESSION_SECRET=
# Supabase > Project Settings > API
SUPABASE_URL=
# "service_role" / "secret" anahtarı (anon değil)
SUPABASE_SERVICE_ROLE_KEY=
# Google AI Studio > Create API key
GEMINI_API_KEY=
# İsteğe bağlı model (varsayılan gemini-flash-latest)
GEMINI_MODEL=

# Uygulamanın internetten erişilen adresi (bağlantılar, webhook'lar ve Gmail script'i için)
APP_URL=

# Yönetim sayfasına girebilecek e-postalar (virgülle)
ADMIN_EMAILS=

# --- Telegram (önerilen; resmi ve ücretsiz) --------------------------------
# @BotFather > /newbot ile alınan anahtar
TELEGRAM_BOT_TOKEN=
# Rastgele uzun bir metin; Telegram'ın webhook isteklerini doğrular
TELEGRAM_WEBHOOK_SECRET=
# Botun kullanıcı adı (@ olmadan), bağlantı düğmesi için
TELEGRAM_BOT_USERNAME=

# --- WhatsApp (Evolution API, isteğe bağlı) ---------------------------------
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Evolution'ın bu uygulamaya mesaj iletirken kullanacağı gizli anahtar
WEBHOOK_SECRET=
# Kullanıcılara gösterilecek bot numarası, ülke koduyla (örn. 905001112233)
WHATSAPP_BOT_NUMBER=

# --- Haftalık rapor ---------------------------------------------------------
# /api/cron/weekly çağrısı için "Authorization: Bearer <CRON_SECRET>". Vercel'de otomatik eklenir.
CRON_SECRET=

# --- Satış -----------------------------------------------------------------
# Pro ödeme bağlantısı (iyzico / Shopier / Stripe Payment Link / PayTR linki).
# Kullanıcının e-postası ?email= olarak eklenir. Boşsa "iletişime geç" gösterilir.
CHECKOUT_URL=
PRO_PRICE=79 ₺ / ay
COMPANY_NAME=
CONTACT_EMAIL=
