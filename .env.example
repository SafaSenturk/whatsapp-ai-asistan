# Bu dosyayı .env.local adıyla kopyalayıp değerleri doldurun.
# .env.local git'e girmez; anahtarları kimseyle paylaşmayın.

# Panel girişi
PANEL_PASSWORD=
# Rastgele uzun bir metin (oturum çerezini imzalar)
SESSION_SECRET=

# Supabase > Project Settings > API
SUPABASE_URL=
# "service_role" / "secret" anahtarı (anon değil)
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio > Create API key
GEMINI_API_KEY=

# Evolution API (Railway)
# Örn: https://evolution-api-production-xxxx.up.railway.app
EVOLUTION_API_URL=
# Railway > Variables > AUTHENTICATION_API_KEY
EVOLUTION_API_KEY=
# Evolution Manager'da oluşturduğunuz instance adı
EVOLUTION_INSTANCE=

# Deneme modu (isteğe bağlı): doluysa bot yalnızca bu numaralarla ilgilenir,
# diğer herkesin mesajı kaydedilmez ve cevaplanmaz. Virgülle ayırın. Canlıya geçerken boşaltın.
# Örn: 905551112233,905554445566
TEST_NUMBERS=

# Evolution'ın bu uygulamaya mesaj iletirken kullanacağı gizli anahtar (rastgele uzun bir metin)
WEBHOOK_SECRET=
# Bu uygulamanın internetten erişilen adresi (webhook kurulumu için)
# Örn: https://whatsapp-bot.up.railway.app
APP_URL=
